# Copy to .env. Never commit .env, credentials, user PDFs or generated media.
# Relative file paths are resolved against the project root, not the shell cwd.
VT_LLM_MODE=rule
VT_QWEN_API_KEY=
VT_QWEN_CREDENTIALS_FILE=
VT_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Select a model available in YOUR region/account; this is the development model.
VT_QWEN_MODEL=qwen3.7-flash
VT_LLM_DEBUG=false
VT_LLM_LOG_DIR=logs
VT_DATA_DIR=data

# TTS is requested only for explicit audio/video generation (cloud charges apply).
VT_TTS_MODE=qwen
VT_QWEN_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
VT_QWEN_TTS_MODEL=qwen3-tts-instruct-flash
VT_QWEN_TTS_VOICE=Cherry
VT_QWEN_TTS_OPTIMIZE_INSTRUCTIONS=false
VT_TTS_OUTPUT_DIR=outputs/audio

# FLOAT is installed separately. Keep its environment separate from Web.
VT_FLOAT_ROOT=../float-main
# Blank uses conda run -n FLOAT; alternatively specify its Python executable.
VT_FLOAT_PYTHON=
VT_FLOAT_ENV=FLOAT
VT_FLOAT_WORKER_URL=http://127.0.0.1:8011
VT_FLOAT_WORKER_TIMEOUT_SECONDS=10
VT_FLOAT_TRANSFER_MODE=path
VT_FLOAT_REFERENCE_IMAGE=assets/teacher/real-teacher-002.png
VT_FLOAT_NO_CROP=false
# On a shared server explicitly select only your assigned physical GPU.
# VT_FLOAT_CUDA_VISIBLE_DEVICES=0
VT_AVATAR_SEGMENT_MAX_CHARS=110
VT_COURSE_MEDIA_CACHE_DIR=outputs/course-media

# Bundled AI-generated portrait; provenance is documented in assets/README.md.
VT_AVATAR_REFERENCE_IMAGE=assets/teacher/real-teacher-002-float-aligned.png
VT_AVATAR_IDLE_VIDEO=assets/private/idle.mp4

# Optional RAG: falls back to BM25 without a local embedding model.
VT_RAG_EMBEDDING_MODEL=../models/bge-small-zh-v1.5
VT_RAG_EMBEDDING_DEVICE=cpu
VT_RAG_EMBEDDING_BATCH_SIZE=8
# Optional CPU ASR, installed in the Web environment with requirements-asr.txt.
VT_ASR_MODEL_DIR=../models/sensevoice-small-int8
VT_ASR_NUM_THREADS=2
