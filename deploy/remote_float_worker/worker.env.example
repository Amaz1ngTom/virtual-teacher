# Copy to worker.env and edit on YOUR server. Trusted Bash configuration.
# Never include passwords/API keys or upload worker.env to GitHub.
FLOAT_ROOT=/workspace/float-main
FLOAT_ENV=FLOAT
# REQUIRED: the physical GPU index assigned to YOU. No default GPU is selected.
PHYSICAL_GPU=
WORKER_PORT=8011
SESSION_NAME=float-worker
# Optional if conda cannot be found:
# CONDA_SH=/path/to/miniconda3/etc/profile.d/conda.sh
